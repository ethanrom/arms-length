# Copy to .env for local work. A public deploy should start with NO variables at all: no key means demo faces only.
#
# YouCam API (https://yce.perfectcorp.com/api-console/en/api-keys/). Server-side only.
YOUCAM_API_KEY=
# Not read by the app today (the API authenticates with the key alone). Leave empty.
YOUCAM_SECRET_KEY=
# live | replay. Keyless means replay: with no YOUCAM_API_KEY the app serves recorded answers whatever this says, and
# /api/youcam/status reports replay_only. With a key, unset or "live" means live; "replay" forces recorded answers.
YOUCAM_MODE=replay
# DEV AND TEST ONLY (Playwright sets it). In replay mode, answer an uploaded photo with a recorded demo face, labelled
# replay. Leave unset on any public deploy: without it an upload is refused with "reserved for judges".
# REPLAY_UPLOADS=1
# Comma-separated access codes that unlock live analysis (given to judges). Empty = live disabled, even with a key.
LIVE_ACCESS_CODES=
# Live mode switches off when the account balance drops to this many units. The minimum is 100: a lower value is raised to 100.
UNIT_FLOOR=100
# Refuses every paid call. Off for empty, 0, false, no, off. ANY other value (1, true, yes, on, a typo) turns it on.
KILL_SWITCH=0
# Live analyses allowed per access code per day, and live renders (makeup + simulation) per code per day.
LIVE_DAILY_CAP=3
LIVE_RENDER_DAILY_CAP=20
# hd | sd. HD by default; SD is the budget fallback.
YOUCAM_ENGINE=hd
# On by default. The browser asks for its YouCam tasks (photo, results, renders) to be deleted when the visitor leaves
# (POST /api/youcam/cleanup). Set to 0 to switch that off.
YOUCAM_DELETE_TASKS=1
