# YouCam API (https://yce.perfectcorp.com/api-console/en/api-keys/). Server-side only.
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
# live | replay. "replay" serves recorded responses from fixtures and spends no units.
YOUCAM_MODE=replay
# Comma-separated access codes that unlock live analysis (given to judges). Empty = live disabled.
LIVE_ACCESS_CODES=
# Live mode switches off when the account balance drops to this many units.
UNIT_FLOOR=100
# Set to 1 to refuse every paid call immediately.
KILL_SWITCH=0
# Live analyses allowed per access code per day, and live renders (makeup + simulation) per code per day.
LIVE_DAILY_CAP=3
LIVE_RENDER_DAILY_CAP=12
# hd | sd. HD by default; SD is the budget fallback.
YOUCAM_ENGINE=hd
# Set to 1 to delete YouCam tasks after a session (endpoint schema unverified).
YOUCAM_DELETE_TASKS=0
