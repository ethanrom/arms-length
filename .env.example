# Copy to .env for local work. A public deploy should start with NO variables at all: no key means demo faces only.
#
# YouCam API (https://yce.perfectcorp.com/api-console/en/api-keys/). Server-side only.
YOUCAM_API_KEY=
# Not read by the app today (the API authenticates with the key alone). Leave empty.
YOUCAM_SECRET_KEY=
# live | replay. Keyless means replay: with no YOUCAM_API_KEY the app serves recorded answers whatever this says, and
# /api/youcam/status reports replay_only. With a key, unset or "live" means live; "replay" forces recorded answers.
# A visitor's own YouCam key (header x-youcam-key) works even on a keyless deploy; only "replay" here turns it away.
YOUCAM_MODE=replay
# DEV AND TEST ONLY (Playwright sets it). In replay mode, answer an uploaded photo with a recorded demo face, labelled
# replay. Leave unset on any public deploy: without it an upload is refused as "needs a key or an access code".
# REPLAY_UPLOADS=1
# Comma-separated access codes that unlock live analysis on the project key. Empty = no codes (live can still be open, below).
LIVE_ACCESS_CODES=
# OPEN LIVE MODE (the judging deploy). 1 = a visitor with no code may use the project key, held by UNIT_FLOOR, the per-address
# daily caps below and LIVE_OPEN_DAILY_CAP. Off for empty, 0, false, no, off; ANY other value turns it on.
LIVE_OPEN=0
# Live analyses per day across ALL open visitors together (about 22 units each with the renders of a session).
LIVE_OPEN_DAILY_CAP=8
# Live mode switches off when the account balance drops to this many units. The minimum is 100: a lower value is raised to 100.
# The judging deploy uses 300.
UNIT_FLOOR=100
# Refuses every paid call, own-key calls included. Off for empty, 0, false, no, off. ANY other value (1, true, yes, on, a typo) turns it on.
KILL_SWITCH=0
# Live analyses allowed per day, and live renders (makeup + simulation) per day. Kept per access code, or per address for
# open visitors. A visitor's own YouCam key spends their units, so these do not apply to it.
LIVE_DAILY_CAP=3
LIVE_RENDER_DAILY_CAP=20
# Signs the tokens that let a visitor's browser ask for its YouCam tasks to be deleted when they leave. Any long random string.
# Falls back to YOUCAM_API_KEY; with neither set, no tokens are issued and clean-up is refused.
TASK_TOKEN_SECRET=
# hd | sd. HD by default; SD is the budget fallback.
YOUCAM_ENGINE=hd
# On by default. The browser asks for its YouCam tasks (photo, results, renders) to be deleted when the visitor leaves
# (POST /api/youcam/cleanup). Set to 0 to switch that off.
YOUCAM_DELETE_TASKS=1

# "Rehearse your day" (the day-planning agent). Off unless AGENT_ENABLED=1. It sends what the visitor types and their
# face's measurements (numbers, never the photo) to Claude Sonnet 5.5 on Amazon Bedrock. No YouCam units.
AGENT_ENABLED=0
# replay serves the recorded plans in fixtures/rehearse (and a deterministic plan for any other day); live calls Bedrock.
AGENT_MODE=live
# Live mode: an example day on a demo face is served from its recorded plan (instant, no model call). 0 turns that off.
AGENT_CACHE=1
# Replay only: pause between re-emitted steps, ms (default 150; e2e uses 0).
AGENT_REPLAY_DELAY_MS=150
# Bedrock credentials and model (a Sonnet 5.5 inference profile id, e.g. global.anthropic.claude-sonnet-5-5).
CLAUDE_AWS_REGION=
CLAUDE_AWS_ACCESS_KEY=
CLAUDE_AWS_SECRET_KEY=
CLAUDE_AWS_MODEL=
# Optional: low (default, about 30% faster at the same pass rate) or medium; prompt caching on unless CLAUDE_AWS_CACHE=0.
CLAUDE_AWS_EFFORT=low
CLAUDE_AWS_CACHE=1
